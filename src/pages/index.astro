---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import WhatIDo from "../components/WhatIDo.astro";
import Stack from "../components/Stack.astro";
import Portfolio from "../components/Portfolio.astro";
import Experience from "../components/Experience.astro";
import Testimonials from "../components/Testimonials.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { cv } from "../data/cv";
---

<Base
  title={`${cv.header.name} · ${cv.header.headline}`}
  description="AI Consultant specializing in Agentic Systems & Automation Architecture. 17+ years building production-ready AI systems for US and European clients."
>
  <Nav />
  <Hero />
  <Stats />
  <WhatIDo />
  <Stack />
  <Portfolio />
  <Experience />
  <Testimonials />
  <Contact />
  <Footer />
</Base>
