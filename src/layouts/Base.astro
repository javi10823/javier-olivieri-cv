---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  printMode?: boolean;
  noindex?: boolean;
}

const { title, description, printMode = false, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en" class={printMode ? "print-mode" : ""}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={printMode ? "print-body" : ""}>
    <slot />
  </body>
</html>
