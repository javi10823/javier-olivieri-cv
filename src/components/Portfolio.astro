---
import { cv } from "../data/cv";

const githubIconSvg = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.38.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.38-1.33-1.75-1.33-1.75-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23A11.5 11.5 0 0112 5.8c1.02 0 2.04.14 3 .4 2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.22.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/></svg>`;
const externalIconSvg = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>`;
---

<section id="portfolio">
  <div class="container">
    <div class="section-label">Portfolio</div>
    <h2 class="section-title">Selected work.</h2>
    <p class="section-sub">
      Real systems, real outcomes. From AI agents to government platforms to US startup products.
    </p>
    <div class="portfolio-grid">
      {
        cv.portfolio.map((card) => (
          <div class={`portfolio-card${card.featured ? " featured" : ""}`}>
            <div class={`portfolio-thumb thumb-bg-${card.thumbVariant}`}>
              <div class="thumb-grid" />
              <div class="thumb-emoji">{card.emoji}</div>
            </div>
            <div class="portfolio-body">
              <div class="portfolio-label">{card.label}</div>
              <div class="portfolio-title">
                {card.title}
                {card.badge && <span class="badge-soon">{card.badge}</span>}
              </div>
              <div class="portfolio-desc">{card.description}</div>
              {card.metrics && (
                <div class="portfolio-metrics">
                  {card.metrics.map((m) => (
                    <div class="pm">
                      <div class="pm-val">{m.value}</div>
                      <div class="pm-key">{m.key}</div>
                    </div>
                  ))}
                </div>
              )}
              <div class="portfolio-tags">
                {card.tags.map((t) => (
                  <span class={`tag${t.teal ? " teal" : ""}`}>{t.label}</span>
                ))}
              </div>
              <div class="portfolio-actions">
                {card.links.live && (
                  <a
                    href={card.links.live.url}
                    target="_blank"
                    rel="noopener"
                    class="btn-case"
                  >
                    <Fragment set:html={externalIconSvg} />
                    {card.links.live.label}
                  </a>
                )}
                {card.links.soon && (
                  <a href="#" class="btn-case disabled" tabindex="-1">
                    <Fragment set:html={externalIconSvg} />
                    View Live
                  </a>
                )}
                {card.links.github && (
                  <a
                    href={card.links.github}
                    target="_blank"
                    rel="noopener"
                    class="btn-gh"
                  >
                    <Fragment set:html={githubIconSvg} />
                    GitHub
                  </a>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
