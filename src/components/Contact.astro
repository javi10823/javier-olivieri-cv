---
import { cv } from "../data/cv";

const { header } = cv;
---

<section id="contact">
  <div class="container">
    <div class="contact-inner">
      <div class="section-label center">Get in Touch</div>
      <h2 class="contact-title">Let's build<br /><span>something real.</span></h2>
      <p class="contact-sub">
        Available for remote contracts with US and European clients. If you're building
        something with AI — or trying to figure out where to start — let's talk.
      </p>

      <div class="contact-form">
        <form action="https://formspree.io/f/xeepgpll" method="POST">
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="name">Name</label>
              <input
                class="form-input"
                type="text"
                id="name"
                name="name"
                placeholder="Your name"
                required
              />
            </div>
            <div class="form-group">
              <label class="form-label" for="email">Email</label>
              <input
                class="form-input"
                type="email"
                id="email"
                name="email"
                placeholder="you@company.com"
                required
              />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="subject">What are you building?</label>
            <input
              class="form-input"
              type="text"
              id="subject"
              name="subject"
              placeholder="AI agent, automation, full-stack product..."
            />
          </div>
          <div class="form-group">
            <label class="form-label" for="message">Message</label>
            <textarea
              class="form-textarea"
              id="message"
              name="message"
              placeholder="Tell me about your project..."
              required></textarea>
          </div>
          <button type="submit" class="btn-primary form-submit">Send Message →</button>
          <div class="form-note">I typically respond within 24 hours.</div>
        </form>
      </div>

      <div class="contact-links">
        <a href={`mailto:${header.email}`} class="contact-link">✉ {header.email}</a>
        <a
          href={`https://${header.linkedin}`}
          target="_blank"
          rel="noopener"
          class="contact-link">in LinkedIn</a
        >
        <a
          href={`https://${header.github}`}
          target="_blank"
          rel="noopener"
          class="contact-link"
        >
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
            <path
              d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.38.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.38-1.33-1.75-1.33-1.75-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23A11.5 11.5 0 0112 5.8c1.02 0 2.04.14 3 .4 2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.22.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"
            ></path>
          </svg>
          GitHub
        </a>
        <a
          href={`https://${header.website}`}
          target="_blank"
          rel="noopener"
          class="contact-link">⊕ {header.website}</a
        >
      </div>
    </div>
  </div>
</section>
