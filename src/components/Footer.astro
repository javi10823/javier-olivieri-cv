---
import { cv } from "../data/cv";

const year = new Date().getFullYear();
const { header } = cv;
const [first, ...rest] = header.headline.split("·").map((s) => s.trim());
const tail = rest.join(" · ");
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-copy">
      {header.name} · <span>{first}</span> · {tail} · {year}
    </div>
    <div class="footer-copy">
      {header.location} · Available Remote · <span>USA / Europe</span>
    </div>
  </div>
</footer>
