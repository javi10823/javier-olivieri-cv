---
import { cv } from "../data/cv";

const { header } = cv;
const [first, ...rest] = header.name.split(" ");
const last = rest.join(" ");
const initials = first[0] + (last[0] ?? "");
---

<section id="hero">
  <div class="hero-grid-bg"></div>
  <div class="hero-glow"></div>
  <div class="container">
    <div class="hero-inner">
      <div class="hero-left">
        <div class="hero-avail">{header.availability}</div>
        <h1 class="hero-name">{first}<br /><span class="teal">{last}</span></h1>
        <div class="hero-role">{header.headline}</div>
        <p class="hero-bio">
          I design and build <strong>agentic AI systems and automation architectures</strong> —
          from autonomous multi-agent pipelines and RAG systems to full-stack AI-native products
          that ship to production.<br /><br />
          With <strong>17+ years in full-stack development</strong> and a track record at US-based
          startups, I specialize in mapping business processes end-to-end, identifying where AI
          creates real leverage, and executing — from blueprint to deployed system.
        </p>
        <div class="hero-actions">
          <a href="#portfolio" class="btn-primary">View Work ↓</a>
          <a href="/cv.pdf" class="btn-secondary" download>Download PDF ↓</a>
          <a href="#contact" class="btn-secondary">Let's Talk →</a>
        </div>
      </div>
      <div class="hero-right">
        <div class="hero-photo-wrap">
          <span class="hero-photo-placeholder">{initials}</span>
        </div>
        <div class="hero-card">
          <a href={`mailto:${header.email}`} class="hero-contact-item">
            <div class="icon">✉</div>
            {header.email}
          </a>
          <a
            href={`https://${header.linkedin}`}
            target="_blank"
            rel="noopener"
            class="hero-contact-item"
          >
            <div class="icon">in</div>
            {header.linkedin}
          </a>
          <a
            href={`https://${header.github}`}
            target="_blank"
            rel="noopener"
            class="hero-contact-item"
          >
            <div class="icon">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
                <path
                  d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.38.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.38-1.33-1.75-1.33-1.75-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23A11.5 11.5 0 0112 5.8c1.02 0 2.04.14 3 .4 2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.22.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"
                ></path>
              </svg>
            </div>
            {header.github}
          </a>
          <a
            href={`https://${header.website}`}
            target="_blank"
            rel="noopener"
            class="hero-contact-item"
          >
            <div class="icon">⊕</div>
            {header.website}
          </a>
          <div class="hero-contact-item static">
            <div class="icon">📍</div>
            {header.location}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
